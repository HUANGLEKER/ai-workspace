# LLM (chat) — DeepSeek example
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-xxx
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# Embedding — can be a different provider from the chat LLM.
# Example: SiliconFlow BAAI/bge-m3 (Chinese-friendly, OpenAI-compatible)
# Leave EMBEDDING_API_KEY/EMBEDDING_API_BASE empty to reuse LLM_* values.
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_PREFIX=ai_workspace

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-workspace
MINIO_SECURE=false

# Service
APP_HOST=0.0.0.0
APP_PORT=8001
APP_DEBUG=true

# CORS — comma-separated allowed origins (default "*", credentials disabled)
CORS_ORIGINS=*
