# ===================================================================
# AI Workspace — AI 服务环境变量配置示例
# 使用前：cp .env.example .env，然后填入真实 Key 与服务地址
# ===================================================================

# -------------------------------------------------------------------
# Chat LLM — 用于对话、Agent 推理、工作流执行
# 以 DeepSeek 为例；任何 OpenAI-compatible 接口均可替换
# -------------------------------------------------------------------
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-xxx
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT=60         # 单次 LLM 请求超时秒数
LLM_MAX_RETRIES=2      # 失败后最大重试次数

# -------------------------------------------------------------------
# Embedding — 文档向量化，可独立于 Chat LLM 使用不同提供商
# DeepSeek 不提供嵌入接口，推荐硅基流动 BAAI/bge-m3（中文友好）
# 若留空 EMBEDDING_API_KEY/EMBEDDING_API_BASE，将自动回退到 LLM_* 配置
# 切换嵌入模型后必须重建所有知识库索引（旧向量与新模型不兼容）
# -------------------------------------------------------------------
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# -------------------------------------------------------------------
# Rerank（重排）— 召回后精排，提升 RAG 命中率（P2-3）
# RERANK_ENABLED=false 时退化为纯向量检索（零额外延迟）
# 留空 RERANK_API_KEY/BASE 回退到 EMBEDDING_* 配置；与嵌入同提供商即可
# -------------------------------------------------------------------
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=sk-xxx
RERANK_API_BASE=https://api.siliconflow.cn/v1
RERANK_RECALL_K=20

# -------------------------------------------------------------------
# 联网搜索 — 为 Chat / RAG 问答提供实时网页召回
# WEB_SEARCH_PROVIDER：duckduckgo（默认，免费、无需 key）/ tavily（预留，需 uv add tavily-python）
# 防御性硬约束：单次搜索 TIMEOUT 秒硬超时（超时降级为空结果，绝不阻断问答），
# 每条结果正文截断至 MAX_CONTENT 字符（防 LLM 上下文 token 溢出）
# -------------------------------------------------------------------
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=        # tavily 等付费 provider 的 key；duckduckgo 留空即可
WEB_SEARCH_TIMEOUT=10      # 单次搜索硬超时（秒）
WEB_SEARCH_MAX_RESULTS=5   # 单次搜索返回的网页条数上限
WEB_SEARCH_MAX_CONTENT=1500  # 每条结果正文截断长度（字符）

# -------------------------------------------------------------------
# Redis — FastAPI 使用 DB 1；Spring Boot 使用 DB 0（避免键冲突）
# -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# -------------------------------------------------------------------
# ChromaDB — 向量库，存储知识库文档的嵌入向量
# CHROMA_COLLECTION_PREFIX 用于多租户隔离前缀，避免不同知识库集合名冲突
# -------------------------------------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_PREFIX=ai_workspace

# -------------------------------------------------------------------
# MinIO — 对象存储，AI 服务在嵌入管道中下载文档时通过此连接读取文件
# 注意：嵌入管道会将下载文件写入 /tmp/，仅支持 POSIX 系统（Linux/macOS/WSL）
# -------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-workspace
MINIO_SECURE=false

# -------------------------------------------------------------------
# FastAPI 服务自身配置
# -------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8001
APP_DEBUG=true         # 开发时开启，生产环境应设为 false

# CORS — 允许跨域的来源（逗号分隔）；默认 "*" 允许所有来源，生产应收紧
CORS_ORIGINS=*

# 分布式链路追踪（OpenTelemetry）——与 Go 网关串联全链路。
# TRACING_ENDPOINT 为 OTLP/HTTP 采集端点（如 http://localhost:4318）；留空则不启用。
TRACING_ENDPOINT=
TRACING_SERVICE_NAME=ai-service
