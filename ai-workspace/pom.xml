<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.0</version>
        <relativePath/>
    </parent>

    <groupId>com.aiworkspace</groupId>
    <artifactId>ai-workspace</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>AI Workspace</name>

    <modules>
        <module>workspace-common</module>
        <module>workspace-framework</module>
        <module>workspace-system</module>
        <module>workspace-chat</module>
        <module>workspace-kb</module>
        <module>workspace-file</module>
        <module>workspace-agent</module>
        <module>workspace-workflow</module>
        <module>workspace-monitor</module>
        <module>workspace-job</module>
        <module>workspace-prompt</module>
        <module>workspace-tool</module>
        <module>workspace-mcp</module>
        <module>workspace-admin</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
        <jjwt.version>0.12.6</jjwt.version>
        <springdoc.version>2.8.0</springdoc.version>
        <hutool.version>5.8.38</hutool.version>
        <lombok.version>1.18.38</lombok.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <dependencyManagement>
        <dependencies>
            <!-- 内部子模块 —— 统一在此声明版本，各子模块 pom 引用时无需重复指定版本号 -->
            <dependency>
                <groupId>com.aiworkspace</groupId>
                <artifactId>workspace-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aiworkspace</groupId>
                <artifactId>workspace-framework</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aiworkspace</groupId>
                <artifactId>workspace-system</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aiworkspace</groupId>
                <artifactId>workspace-chat</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aiworkspace</groupId>
                <artifactId>workspace-kb</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aiworkspace</groupId>
                <artifactId>workspace-file</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aiworkspace</groupId>
                <artifactId>workspace-agent</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aiworkspace</groupId>
                <artifactId>workspace-workflow</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aiworkspace</groupId>
                <artifactId>workspace-monitor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aiworkspace</groupId>
                <artifactId>workspace-job</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aiworkspace</groupId>
                <artifactId>workspace-prompt</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aiworkspace</groupId>
                <artifactId>workspace-tool</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aiworkspace</groupId>
                <artifactId>workspace-mcp</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- MyBatis Plus —— ORM 框架，提供通用 CRUD、逻辑删除、自动填充等能力 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- JWT (JJWT) —— HS256 签名的 Token 生成与校验；impl/jackson 为运行时依赖 -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>

            <!-- SpringDoc OpenAPI —— 自动生成 Swagger UI，访问 /swagger-ui.html -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- Hutool —— 工具库，提供字符串/时间/加密等通用能力 -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- MinIO —— 对象存储客户端，文件中心上传/下载及 RAG 嵌入管道依赖 -->
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>8.5.11</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>